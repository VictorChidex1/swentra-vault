rules_version = '2';

// Default-deny baseline for the Swentra Vault prototype.
//
// KYC documents and all other objects are denied until ownership/admin rules
// are written in the security-hardening phase. Sensitive documents must never
// be publicly accessible.
service firebase.storage {
  match /b/{bucket}/o {
    match /kyc/{uid}/identity/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
    
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
