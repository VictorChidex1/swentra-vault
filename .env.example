# Firebase web configuration (client-side identifiers, not secrets).
# Copy to .env.local and fill with the values from your Firebase project settings.
# The Firebase web API key is a public client identifier, not a secret.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check reCAPTCHA site key (Phase 13). Created in the Google Cloud Fraud
# Defense console; register the app in Firebase → App Check and paste the
# reCAPTCHA Enterprise site key here. Kept empty/unset in the example.
VITE_APPCHECK_SITE_KEY=
