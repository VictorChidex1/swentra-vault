# Swentra Vault Cloud Functions environment.
# Copy this file to functions/.env and fill in the values. functions/.env is
# gitignored and is read by `firebase deploy --only functions` at deploy time,
# so it must exist on the machine that deploys the functions.

# Resend API key. Required for sending auth emails (verification, resend, reset).
# Keep the real value ONLY in functions/.env (gitignored). Never in this file.
RESEND_API_KEY=

# Public app origin used for links inside auth emails.
# Defaults to https://swentravault.com when unset.
APP_URL=https://swentravault.com

# Verified Resend sender. The domain must be verified in Resend (send.swentravault.com).
MAIL_FROM=Swentra Vault <noreply@send.swentravault.com>

# Monitored mailbox replies to auth emails land in (Reply-To).
MAIL_REPLY_TO=support@swentravault.com