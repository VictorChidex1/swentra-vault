rules_version = '2';

// Default-deny baseline for the Swentra Vault prototype.
//
// All client access is denied until per-collection rules are written in the
// security-hardening phase. Cloud Functions using the Admin SDK bypass these
// rules and remain the only trusted writer of authoritative financial state.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid || isAdmin();
      allow write: if isAdmin();
    }

    match /users/{uid}/accounts/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid || isAdmin();
      allow write: if isAdmin(); // Admins can modify accounts if needed
    }

    match /users/{uid}/kyc/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid || isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid 
                    && request.resource.data.status == 'UNDER_REVIEW';
      allow write: if isAdmin();
    }

    match /users/{uid}/beneficiaries/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid || isAdmin();
    }

    match /users/{uid}/transactions/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid || isAdmin();
      allow write: if isAdmin(); 
    }

    match /{path=**}/kyc/{docId} {
      allow read: if isAdmin();
    }

    match /{path=**}/accounts/{docId} {
      allow read: if isAdmin();
    }

    match /{path=**}/transactions/{docId} {
      allow read: if isAdmin();
    }

    // Server-authoritative data — written only by Cloud Functions (Admin SDK),
    // never exposed to the client.
    match /accountNumbers/{accountNumber} {
      allow read, write: if false;
    }

    match /transferQuotes/{quoteId} {
      allow read, write: if false;
    }

    match /emailThrottle/{hash} {
      allow read, write: if false;
    }

    match /system/{document=**} {
      allow read, write: if false;
    }

    // Audit & security-event records — admin read only; written only by
    // Cloud Functions (Admin SDK).
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /securityEvents/{eventId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
